<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for the self-contained single-file build.

  Usage:
    dotnet publish BP-Analyzer.csproj -p:PublishProfile=BP-Analyzer-win-x64

  Result: a single BP-Analyzer.exe (win-x64) that needs no .NET runtime and no
  extra files - the templates are embedded in the assembly.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
